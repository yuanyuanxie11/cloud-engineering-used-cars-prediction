# Local synthetic / dry-run scratch — NEVER the source of truth.
# Real metrics + artifacts live in s3://<bucket>/artifacts/models/latest/.
out/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Notebooks: keep code, drop heavy/volatile checkpoints
.ipynb_checkpoints/

# Models / data accidentally saved locally
*.pkl
*.parquet
metrics.json

# OS / editor
.DS_Store
.vscode/
.idea/

Project.pdf

# === Secrets & credentials (NEVER commit) ===
# Env files often hold API keys, DB passwords, etc.
.env
.env.*
*.env

# AWS CLI credentials and config
.aws/
credentials

# SSH / TLS private keys
*.pem
*.key
*.crt
*.p12

# Terraform state files contain plaintext secrets
*.tfstate
*.tfstate.*
.terraform/

# Generic secret-ish files
secrets/
*.secret
*_secret*

# Logs may accidentally leak tokens
*.log
